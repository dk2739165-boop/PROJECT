# ==============================================================================
# Frontend Client Environment Variables (Template)
# Copy this file to .env and fill in your values
# ==============================================================================

# Target Backend Server URL (where Node.js / Express is running)
BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# Supabase Public Database Configuration (Frontend)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Row Level Security protected, safe for browser)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
