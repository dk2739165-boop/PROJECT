# ==============================================================================
# Gemini Chatbot Backend Environment Variables (Template)
# Copy this file to .env and fill in your values
# ==============================================================================

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Server Port
PORT=5000

# Default Model: gemini-2.5-flash | gemini-2.5-pro | gemini-1.5-flash | gemini-1.5-pro
DEFAULT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Supabase Database Configuration (Backend)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Keep private on backend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
